<script>
  document.addEventListener("DOMContentLoaded", function () {
  function waitForjQuery(callback) {
    if (typeof jQuery !== 'undefined') {
      callback(jQuery);
    } else {
      setTimeout(function () {
        waitForjQuery(callback);
      }, 50);
    }
  }

  waitForjQuery(function ($) {
    console.log("jQuery ready and DOM loaded");

    function toggleDimensionWrapper() {
      const $checkboxBtn = $('.tpo_option-set-wrapper .tpo-checkbox-button');

      // Fallback if data-checked is missing
      if (!$checkboxBtn.attr('data-checked')) {
        $checkboxBtn.attr('data-checked', 'false');
      }

      const isChecked = $checkboxBtn.attr('data-checked') === 'true';
      const $dimensionWrapper = $('.tpo_option-container .tpo_option-group_wrapper');

      if (isChecked) {
        $dimensionWrapper.stop(true, true).slideDown(300);
      } else {
        $dimensionWrapper.stop(true, true).slideUp(300);
      }
    }

    toggleDimensionWrapper();

    $(document).on('click', '.tpo_option-set-wrapper .tpo-checkbox-button', function () {
      const $this = $(this);
      const currentState = $this.attr('data-checked') === 'true';
      $this.attr('data-checked', !currentState);
      toggleDimensionWrapper();
    });
  });
});

</script>