{% form 'contact', id: 'contact-form-custom-tailoring' %}
  <!-- Product Details -->
  <input type="hidden" name="contact[product]" value="{{ product.title }}">
  <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">

  <!-- Selected Variant Details -->
  <input type="hidden" name="contact[dress_type]" id="selected_variant_dress" value="">
  <input type="hidden" name="contact[article_no]" id="selected_variant_article" value="">
  
  <!-- Form Fields -->
  <div class="m-form-custom-tailoring__wrapper">
    <input
      type="text"
      class="form-field form-field--input"
      name="contact[name]"
      required
      placeholder="{{ 'contact.ask-form.name' | t }}*"
    >
    <input
      type="text"
      class="form-field form-field--input"
      name="contact[phone]"
      required
      placeholder="{{ 'contact.ask-form.phone' | t }}*"
    >
    <input
      type="email"
      class="form-field form-field--input"
      name="contact[email]"
      required
      autocorrect="off"
      placeholder="{{ 'contact.ask-form.email' | t }}*"
    >
    {% comment %}
    <input
      type="text"
      class="form-field form-field--input"
      name="contact[date]"
      placeholder="Choose Date *"
      onfocus="(this.type='date')"
      onblur="(this.type='text')"
      required
    >

    <!-- Time Slots -->
    <br><br>
    <div class="time-label">Time *</div>
    <div class="time-wrap">
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="11:00AM - 12:00PM" required> 11:00AM - 12:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="1:00PM - 2:00PM"> 1:00PM - 2:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="2:00PM - 3:00PM"> 2:00PM - 3:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="3:00PM - 4:00PM"> 3:00PM - 4:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="4:00PM - 5:00PM"> 4:00PM - 5:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="5:00PM - 6:00PM"> 5:00PM - 6:00PM</label>
      <label><input class="form-field form-field--input" type="radio" name="contact[time]" value="6:00PM - 7:00PM"> 6:00PM - 7:00PM</label>
    </div>
    <br>
    

    <!-- Message Field -->
    <textarea
      class="form-field form-field--input"
      name="contact[question]"
      rows="4"
      required
      placeholder="{{ 'contact.ask-form.message' | t }}*"
    ></textarea>{% endcomment %}
    <p class="m-form-ask-question__note m:text-left m:text-color-subtext">* {{ 'contact.ask-form.required-fields' | t }}</p>
    <button type="submit" class="m-button m-button--primary">Request Price</button>
  </div>

  <!-- Success Message -->
  {% if form.posted_successfully? %}
    <div
      class="form-ask__success"
      data-message="{{ 'contact.ask-form.post_success' | t }}"
    ></div>
  {% endif %}
{% endform %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Function to update hidden input fields based on selected values
  const updateHiddenInputs = () => {
    const dressTypeElement = document.querySelector('[data-option-name="Dress Type"][data-selected-value]');
    const articleNoElement = document.querySelector('[data-option-name="Article No"][data-selected-value]');

    // Fetch the data-selected-value values
    const dressTypeValue = dressTypeElement ? dressTypeElement.getAttribute('data-selected-value') : '';
    const articleNoValue = articleNoElement ? articleNoElement.getAttribute('data-selected-value') : '';

    // Update the hidden input fields
    document.getElementById('selected_variant_dress').value = dressTypeValue;
    document.getElementById('selected_variant_article').value = articleNoValue;
  };

  // Monitor changes in the data-selected-value attribute
  const observer = new MutationObserver(updateHiddenInputs);

  // Target all elements with data-option-name="Dress Type" and "Article No"
  const targetElements = document.querySelectorAll('[data-option-name][data-selected-value]');

  targetElements.forEach(element => {
    observer.observe(element, { attributes: true, attributeFilter: ['data-selected-value'] });
  });

  // Initialize the inputs on page load
  updateHiddenInputs();
});



</script>

