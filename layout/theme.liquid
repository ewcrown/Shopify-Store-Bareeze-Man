{% liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
  
  assign body_classes = 'template-' | append: template.name | append: ' ' | append: template.suffix | append: ' m-gradient m-color-' | append: settings.default_color_scheme
  if settings.page_transition
    assign body_classes = body_classes | append: ' m:overflow-hidden'
  endif
  if template.suffix == 'about-us'
    assign body_classes = body_classes | append: ' sf__page-about'
  endif
%}
<!doctype html>
<html
  class="no-js {% if settings.page_transition %} m:overflow-hidden{% endif %}"
  lang="{{ request.locale.iso_code }}"
  data-template="{{ template.name }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    
    <script>
  (function () {
    var BLOCK_ID = 'm-custom__block--video_eDc6NR';
    var POSTER   = 'https://cdn.shopify.com/s/files/1/0726/6068/0948/files/Screenshot_2026-05-22_at_2.15.08_PM.png?v=1779441319';

    function prepareVideo(video) {
      if (!video || video.dataset.prepared) return;
      video.dataset.prepared = 'true';
      video.removeAttribute('autoplay');
      video.setAttribute('poster', POSTER);
      video.load();
      video.pause();
    }

    function init() {
      var block = document.getElementById(BLOCK_ID);
      if (!block) return;

      var video = block.querySelector('video');
      if (video) {
        prepareVideo(video);
        return;
      }

      var observer = new MutationObserver(function () {
        var v = block.querySelector('video');
        if (v) {
          prepareVideo(v);
          observer.disconnect();
        }
      });
      observer.observe(block, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

    {%- if settings.use_favicon == true and settings.favicon != blank -%}
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if template == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      render 'social-meta-tags'
      render 'font-face'
      render 'critical-css'

      echo 'main.css' | asset_url | stylesheet_tag: preload: true

      render 'style-tags'
    -%}

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme-global.js' | asset_url }}" defer="defer"></script>
    {%- if settings.animations != 'none' -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    {% render 'theme-data' %}
    {% render 'custom-code-head' %}
    {{ 'growex.css' | asset_url | stylesheet_tag }}
  </head>

  <body
    id="m-theme"
    class="{{ body_classes }}"
    {% if template.name == 'product' %}
      data-product-id="{{ product.id }}"
    {% endif %}
  >
    {%- liquid
      render 'page-transition'
      render 'scroll-top-button'
      sections 'header-group'
    -%}

    <main role="main" id="MainContent">
      {{ content_for_layout }}
    </main>

    {%- liquid
      sections 'footer-group'
      render 'script-tags'
      render 'cookie-banner'
      render 'custom-code-body'
    -%}

    <script src="{{ 'product-quick-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'compare-product.js' | asset_url }}" defer="defer"></script>

    {%- if settings.enable_predictive_search -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if linklists['gift-wrapping'].links != blank
      and linklists['gift-wrapping'].links.first.type == 'product_link'
    -%}
      <script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.show_swatch_option -%}
      <script src="{{ 'product-card-swatch.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if settings.enable_cart_drawer and template != 'cart' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}
{% comment %} 
{% unless request.path contains 'pages/brand' %}
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const inEditor = window.Shopify && window.Shopify.designMode;

      // ✅ Redirect only if NOT in customizer/editor
      if (!inEditor && !document.cookie.includes('templateSelected=true')) {
        window.location.href = '/pages/brand';
      }
    });
  </script>
{% endunless %} {% endcomment %}


{% comment %} {% unless request.path contains 'pages/brand' %}
<script>
document.addEventListener("DOMContentLoaded", function () {
  const inEditor = window.Shopify && window.Shopify.designMode;
  if (inEditor) return;

  const isInternalNav =
    document.referrer &&
    document.referrer.includes(window.location.origin);

  const hasCookie = document.cookie.includes("templateSelected=true");

  /* ✅ Redirect ONLY on first direct visit */
  if (!hasCookie && !isInternalNav) {
    window.location.href = "/pages/brand";
  }
});
</script>
{% endunless %} {% endcomment %}

{% comment %} {% if request.path == '/' %}
<script>
document.addEventListener("DOMContentLoaded", function () {
  const inEditor = window.Shopify && window.Shopify.designMode;
  if (inEditor) return;

  const isInternalNav =
    document.referrer &&
    document.referrer.includes(window.location.origin);

  const hasCookie = document.cookie.includes("templateSelected=true");

  /* ✅ Redirect ONLY on first direct visit to homepage */
  if (!hasCookie && !isInternalNav) {
    window.location.href = "/pages/brand";
  }
});
</script>
{% endif %}


 <script>
  document.addEventListener("DOMContentLoaded", function () {
    const inEditor = window.Shopify && window.Shopify.designMode;

    // ✅ Prevent code from affecting customizer
    if (inEditor) return;

    const buttons = document.querySelectorAll(".promo-button");

    buttons.forEach(button => {
      button.addEventListener("click", function (e) {
        // ✅ 1. Cookie set karo taake dobara redirect na ho
        document.cookie = "templateSelected=true; path=/; max-age=" + 60 * 60 * 24 * 30; // valid for 30 days

        // ✅ 2. Redirect karo button ke link par
        const link = e.target.getAttribute("data-link") || e.target.href;
        if (link) {
          window.location.href = link;
        }
      });
    });
  });
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const currentUrl = window.location.href.replace(/\/$/, ""); // remove trailing slash
  const savedBrand = localStorage.getItem("selectedBrand") || "maria";

  if (savedBrand === "mbasics" && currentUrl === "https://bareezeman.com") {
    window.location.href = "https://bareezeman.com/pages/savant";
    return;
  }

  if (savedBrand === "maria" && currentUrl === "https://bareezeman.com/pages/savant") {
    window.location.href = "https://bareezeman.com";
    return;
  }

  function updateBrandUI(brand) {
    if (brand === "maria") {
      document.body.classList.add("index-layout");
      document.body.classList.remove("joolie-layout");
    } else if (brand === "mbasics") {
      document.body.classList.remove("index-layout");
      document.body.classList.add("joolie-layout");
    }
  }

  updateBrandUI(savedBrand);

  function detectBrand(el) {
    if (!el) return null;
    if (el.classList.contains("maria")) return "maria";
    if (el.classList.contains("mbasics")) return "mbasics";
    const parent = el.closest(".maria, .mbasics");
    if (parent) {
      if (parent.classList.contains("maria")) return "maria";
      if (parent.classList.contains("mbasics")) return "mbasics";
    }
    return null;
  }

  document.addEventListener("pointerdown", function (ev) {
    const brand = detectBrand(ev.target);
    if (brand) {
      localStorage.setItem("selectedBrand", brand);
      updateBrandUI(brand);
    }
  }, { passive: true });

  document.addEventListener("click", function (ev) {
    const brand = detectBrand(ev.target);
    const anchor = ev.target.closest("a[href]");
    if (brand && anchor) {
      ev.preventDefault();
      localStorage.setItem("selectedBrand", brand);
      updateBrandUI(brand);
      const url = anchor.getAttribute("href");
      setTimeout(() => { window.location.href = url; }, 50);
    }
  });
});
</script> {% endcomment %}
  </body>
</html>
