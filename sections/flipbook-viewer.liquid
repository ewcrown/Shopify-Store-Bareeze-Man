{% comment %}
  Section: Professional Image Flipbook
  Description: Custom flipbook viewer with StPageFlip library for image catalogs
{% endcomment %}

<style>
  .flipbook-catalog-section {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    position:relative;
  }

  .flipbook-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }



  .flipbook-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .flipbook-title {
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    color: {{ section.settings.title_color }};
    margin-bottom: 15px;
    text-transform: {{ section.settings.title_transform }};
    letter-spacing: 1px;
  }

  .flipbook-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 0;
  }

  /* StPageFlip Flipbook Styles */
  .flipbook-wrapper {
    position: relative;
    background: #ffffff;
    border-radius: {{ section.settings.border_radius }}px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    overflow: hidden;
    margin-bottom: 30px;
    user-select: none;
  }

  .stf__wrapper {
    position: relative;
    display: block;
    box-sizing: border-box;
    transform: translateZ(0);
    min-width: 350px;
    min-height: 467px;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    transition: transform 0.3s ease;
  }

  /* Ensure first page (cover) is properly centered */
  .stf__wrapper.--portrait .stf__item:first-child {
    margin: 0 auto;
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    border-radius: 8px 0 0 8px;
  }

  .stf__wrapper.--portrait {
    background: transparent;
  }

  .stf__wrapper.--portrait .stf__item {
    background: white;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .stf__wrapper canvas {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
  }

  .stf__block {
    position: absolute;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .stf__item {
    display: none;
    position: absolute;
  }

  .flipbook-page {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .flipbook-page img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
    image-rendering: high-quality;
    -ms-interpolation-mode: bicubic;
  }

  /* Side Navigation Controls - Full Corner Positioning */
  .flipbook-side-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
  }

  .flipbook-side-nav.left {
    left: 0px;
  }

  .flipbook-side-nav.right {
    right: 0px;
  }

  .flipbook-side-nav-btn {
    background: rgba(255,255,255,0.9);
    color: #333;
    border: none;
    width: 60px;
    height: 60px;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 24px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    backdrop-filter: blur(10px);
  }

  .flipbook-side-nav.left .flipbook-side-nav-btn {
    border-radius: 0 30px 30px 0;
  }

  .flipbook-side-nav.right .flipbook-side-nav-btn {
    border-radius: 30px 0 0 30px;
  }

  .flipbook-side-nav-btn:hover {
    background: rgba(255,255,255,1);
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .flipbook-side-nav-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Bottom Controls - Full Width Below Image */
  .flipbook-controls {
    position: relative;
    margin-top: 0px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,0.95);
    padding: 15px 25px;
    border-radius: 15px;
    z-index: 1000;
  }

  /* Left Controls Group */
  .flipbook-left-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Center Controls Group - Theme Style */
  .flipbook-center-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    background: transparent;
    padding: 0;
  }

  /* Right Controls Group */
  .flipbook-right-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Theme-style Navigation Buttons */
  .flipbook-page-nav-btn {
    background: transparent;
    border: none;
    color: #333;
    cursor: pointer;
    padding: 8px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    font-size: 24px;
    font-weight: 300;
  }

  .flipbook-page-nav-btn:hover {
    color: #000;
    transform: scale(1.1);
  }

  .flipbook-page-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
  }

  /* Theme-style Page Counter */
  .flipbook-page-info {
    font-size: 18px;
    font-weight: 400;
    color: #333;
    text-align: center;
    display: flex;
    align-items: center;
    gap: 0;
    background: transparent;
    padding: 0;
    border-radius: 0;
    min-width: auto;
  }

  .flipbook-page-counter {
    margin: 0;
    font-weight: 400;
    font-size: 18px;
    letter-spacing: 0.5px;
  }

  /* Theme-style Arrow Icons */
  .flipbook-page-nav-btn svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
  }

  /* First/Last page buttons with double arrows */
  .flipbook-page-nav-btn.double-arrow svg {
    width: 24px;
    height: 24px;
  }

  .flipbook-action-btn {
    background: transparent;
    border: 2px solid {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_bg_color }};
    padding: 10px 16px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .flipbook-action-btn:hover {
    background: {{ section.settings.button_bg_color }};
    color: white;
    transform: translateY(-2px);
  }

  /* Autoplay Button */
  .flipbook-play-btn {
    background: transparent;
    border: 2px solid {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_bg_color }};
    padding: 10px;
    border-radius: 50%;
    cursor: pointer;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 16px;
  }

  .flipbook-play-btn:hover {
    background: {{ section.settings.button_bg_color }};
    color: white;
    transform: scale(1.1);
  }

  .flipbook-play-btn.playing {
    background: {{ section.settings.button_bg_color }};
    color: white;
  }

  /* Single Zoom Toggle Button */
  .flipbook-zoom-btn {
    background: transparent;
    border: 2px solid {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_bg_color }};
    padding: 10px;
    border-radius: 50%;
    cursor: pointer;
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 16px;
  }

  .flipbook-zoom-btn:hover {
    background: {{ section.settings.button_bg_color }};
    color: white;
    transform: scale(1.1);
  }

  .flipbook-zoom-btn.zoomed {
    background: {{ section.settings.button_bg_color }};
    color: white;
  }

  /* Ensure line-style icons work properly */
  .flipbook-zoom-btn svg,
  .flipbook-action-btn svg,
  .flipbook-play-btn svg {
    stroke: currentColor;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Special handling for filled elements in icons */
  .flipbook-play-btn svg polygon,
  .flipbook-zoom-btn svg line {
    fill: currentColor;
    stroke: none;
  }

  /* Image Popup Modal */
  .flipbook-modal {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.9);
    backdrop-filter: blur(5px);
  }

  .flipbook-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flipbook-modal-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    margin: auto;
  }

  .flipbook-modal-image {
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: high-quality;
    -ms-interpolation-mode: bicubic;
  }

  .flipbook-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    color: white;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    background: rgba(0,0,0,0.5);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .flipbook-modal-close:hover {
    background: rgba(0,0,0,0.8);
    transform: scale(1.1);
  }

  /* Full Width Page Preview Modal */
  .flipbook-preview-modal {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.95);
    backdrop-filter: blur(10px);
    animation: fadeIn 0.3s ease;
  }

  .flipbook-preview-modal.active {
    display: block;
  }

  .flipbook-preview-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(10px);
    padding: 15px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10001;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .flipbook-preview-title {
    font-size: 18px;
    font-weight: 600;
    color: #333;
    margin: 0;
  }

  .flipbook-preview-close {
    background: none;
    border: none;
    font-size: 24px;
    color: #666;
    cursor: pointer;
    padding: 5px;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .flipbook-preview-close:hover {
    background: rgba(0,0,0,0.1);
    color: #000;
  }

  .flipbook-preview-content {
    position: absolute;
    top: 70px;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 30px;
    display: flex;
    align-items: center;
    gap: 20px;
    background: #000;
  }

  .flipbook-preview-page {
    position: relative;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
    cursor: pointer;
    flex-shrink: 0;
    width: 280px;
    height: 400px;
  }

  .flipbook-preview-page:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
  }

  .flipbook-preview-page img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .flipbook-preview-page-number {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(0,0,0,0.8);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    backdrop-filter: blur(10px);
  }

  .flipbook-preview-page-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    opacity: 0;
  }

  .flipbook-preview-page:hover .flipbook-preview-page-overlay {
    background: rgba(0,0,0,0.4);
    opacity: 1;
  }

  .flipbook-preview-page-action {
    background: white;
    border: none;
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    cursor: pointer;
    transform: translateY(20px);
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
  }

  .flipbook-preview-page:hover .flipbook-preview-page-action {
    transform: translateY(0);
  }

  /* Loading State */
  .flipbook-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #666;
    z-index: 100;
  }

  .flipbook-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid {{ section.settings.button_bg_color }};
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 15px;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .flipbook-container {
      padding: 0 15px;
    }

    .flipbook-title {
      font-size: {{ section.settings.title_size | minus: 8 }}px;
    }

    .flipbook-side-nav.left {
      left: 0px;
    }

    .flipbook-side-nav.right {
      right: 0px;
    }

    .flipbook-side-nav-btn {
      width: 50px;
      height: 50px;
      font-size: 18px;
    }

    .flipbook-controls {
      margin-top: 15px;
      padding: 12px 20px;
      flex-direction: column;
      gap: 15px;
    }

    .flipbook-left-controls,
    .flipbook-center-controls,
    .flipbook-right-controls {
      width: 100%;
      justify-content: center;
    }

    .flipbook-center-controls {
      order: 1;
      gap: 15px;
    }

    .flipbook-left-controls {
      order: 2;
    }

    .flipbook-right-controls {
      order: 3;
    }

    .flipbook-action-btn {
      font-size: 12px;
      padding: 8px 14px;
    }

    .flipbook-play-btn {
      width: 40px;
      height: 40px;
      font-size: 14px;
    }

    .flipbook-zoom-btn {
      width: 40px;
      height: 40px;
      font-size: 14px;
    }

    .flipbook-page-info {
      font-size: 16px;
    }

    .flipbook-page-nav-btn {
      width: 35px;
      height: 35px;
      font-size: 20px;
    }

    .stf__wrapper {
      min-width: 300px;
      min-height: 400px;
    }
  }

  @media (max-width: 480px) {
    .flipbook-container {
      padding: 0 10px;
    }

    .flipbook-controls {
      margin-top: 10px;
      padding: 10px 15px;
      gap: 10px;
    }

    .flipbook-left-controls,
    .flipbook-center-controls,
    .flipbook-right-controls {
      gap: 8px;
    }

    .flipbook-action-btn {
      font-size: 11px;
      padding: 6px 12px;
    }

    .flipbook-nav-btn {
      width: 35px;
      height: 35px;
      font-size: 14px;
    }

    .flipbook-play-btn,
    .flipbook-zoom-btn {
      width: 35px;
      height: 35px;
    }

    .flipbook-page-info {
      font-size: 13px;
      min-width: 80px;
      padding: 6px 12px;
    }

    .flipbook-side-nav-btn {
      width: 45px;
      height: 45px;
      font-size: 20px;
    }
  }

  /* Fullscreen Styles */
  .flipbook-wrapper:fullscreen {
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .flipbook-wrapper:fullscreen .stf__wrapper {
    max-width: 95vw;
    max-height: calc(95vh - 100px);
    flex: 1;
  }

  .flipbook-wrapper:fullscreen .flipbook-controls {
    position: relative;
    margin-top: 20px;
    background: rgba(255,255,255,0.95);
  }

  .flipbook-wrapper:fullscreen .flipbook-side-nav {
    z-index: 1001;
  }
</style>

<div class="flipbook-catalog-section">
  <div class="flipbook-container">
    {% if section.settings.show_header %}
      <div class="flipbook-header">
        {% if section.settings.title != blank %}
          <h2 class="flipbook-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="flipbook-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="flipbook-wrapper" id="flipbookWrapper">
      {% if section.blocks.size > 0 %}
        <div class="stf__wrapper" id="flipbook">
          <div class="stf__block">
            {% for block in section.blocks %}
              <div
                class="stf__item flipbook-page"
                data-page="{{ forloop.index }}"
                onclick="openImageModal('{{ block.settings.image | image_url: width: 2048 }}')"
              >
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.alt_text | default: 'Catalog Page ' | append: forloop.index }}"
                    loading="lazy"
                  >
                {% else %}
                  <div style="display: flex; align-items: center; justify-content: center; height: 100%; background: #f5f5f5; color: #999;">
                    <p>Add image in block settings</p>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="flipbook-loading">
          <div class="flipbook-spinner"></div>
          <p>Add images in the section blocks to create your flipbook</p>
        </div>
      {% endif %}
    </div>
  </div>
  {% if section.settings.show_controls and section.blocks.size > 0 %}
    <!-- Side Navigation Controls -->
    <div class="flipbook-side-nav left">
      <button class="flipbook-side-nav-btn" id="prevPage" title="Previous Page">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>
    </div>

    <div class="flipbook-side-nav right">
      <button class="flipbook-side-nav-btn" id="nextPage" title="Next Page">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  {% endif %}
  {% if section.settings.show_controls and section.blocks.size > 0 %}
    <!-- Bottom Controls - Reorganized Layout -->
    <div class="flipbook-controls">
      <!-- Left Controls: Zoom & View All -->
      <div class="flipbook-left-controls">
        <!-- Single Zoom Toggle Button -->
        <button class="flipbook-zoom-btn" id="zoomToggle" title="Zoom In">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="zoom-in-icon">
            <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
            <circle cx="9" cy="9" r="3" stroke-width="2"></circle>
            <path d="m12 12 3 3" stroke-width="2"></path>
          </svg>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="zoom-out-icon"
            style="display: none;"
          >
            <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
            <circle cx="9" cy="9" r="3" stroke-width="2"></circle>
            <path d="m12 12 3 3" stroke-width="2"></path>
            <line x1="7" y1="9" x2="11" y2="9" stroke-width="2"></line>
          </svg>
        </button>

        <!-- View All Pages Button -->
        <button class="flipbook-action-btn" id="previewView" title="View All Pages">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="7" height="7" stroke-width="2"></rect>
            <rect x="14" y="3" width="7" height="7" stroke-width="2"></rect>
            <rect x="14" y="14" width="7" height="7" stroke-width="2"></rect>
            <rect x="3" y="14" width="7" height="7" stroke-width="2"></rect>
          </svg>
          View All
        </button>
      </div>

      <!-- Center Controls: Navigation Arrows & Page Numbers - Theme Style -->
      <div class="flipbook-center-controls">
        <!-- First Page Button - Double Left Arrow -->
        <button class="flipbook-page-nav-btn double-arrow" id="firstPage" title="First Page">⇤</button>

        <!-- Previous Single Page Button - Single Left Arrow -->
        <button class="flipbook-page-nav-btn" id="prevSinglePage" title="Previous Page">←</button>

        <!-- Page Info - Theme Style Format -->
        <div class="flipbook-page-info">
          <span class="flipbook-page-counter">
            <span id="currentPage">1</span>-<span id="currentPageEnd">{{ section.blocks.size | at_most: 2 }}</span
            >/<span id="totalPages">{{ section.blocks.size }}</span>
          </span>
        </div>

        <!-- Next Single Page Button - Single Right Arrow -->
        <button class="flipbook-page-nav-btn" id="nextSinglePage" title="Next Page">→</button>

        <!-- Last Page Button - Double Right Arrow -->
        <button class="flipbook-page-nav-btn double-arrow" id="lastPage" title="Last Page">⇥</button>
      </div>

      <!-- Right Controls: Autoplay & Fullscreen -->
      <div class="flipbook-right-controls">
        <!-- Autoplay Button -->
        <button class="flipbook-play-btn" id="autoplayBtn" title="Auto Play">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="play-icon">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="2"></rect>
            <polygon points="10,8 16,12 10,16" fill="currentColor" stroke="none"></polygon>
          </svg>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="pause-icon"
            style="display: none;"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" stroke-width="2"></rect>
            <line x1="10" y1="9" x2="10" y2="15" stroke-width="2"></line>
            <line x1="14" y1="9" x2="14" y2="15" stroke-width="2"></line>
          </svg>
        </button>

        <!-- Fullscreen Button -->
        <button class="flipbook-action-btn" id="fullscreenBtn" title="Fullscreen">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="fullscreen-enter-icon"
          >
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" stroke-width="2"></path>
          </svg>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="fullscreen-exit-icon"
            style="display: none;"
          >
            <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3" stroke-width="2"></path>
          </svg>
          Fullscreen
        </button>
      </div>
    </div>
  {% endif %}
</div>

<!-- Image Popup Modal -->
<div class="flipbook-modal" id="imageModal">
  <div class="flipbook-modal-content">
    <span class="flipbook-modal-close" onclick="closeImageModal()">&times;</span>
    <img class="flipbook-modal-image" id="modalImage" src="" alt="Catalog Page">
  </div>
</div>

<!-- Full Width Page Preview Modal -->
<div class="flipbook-preview-modal" id="previewModal">
  <div class="flipbook-preview-header">
    <h3 class="flipbook-preview-title">{{ section.settings.title | default: 'Catalog Preview' }} - All Pages</h3>
    <button class="flipbook-preview-close" onclick="closePreviewModal()" aria-label="Close Preview">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>
  </div>
  <div class="flipbook-preview-content" id="previewContent">
    {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <div class="flipbook-preview-page" onclick="goToPageFromPreview({{ forloop.index }})">
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.alt_text | default: 'Catalog Page ' | append: forloop.index }}"
            loading="lazy"
          >
          <div class="flipbook-preview-page-number">{{ forloop.index }}</div>
          <div class="flipbook-preview-page-overlay">
            <button class="flipbook-preview-page-action">Go to Page</button>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<!-- StPageFlip Library -->
<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const flipbookElement = document.getElementById('flipbook');
    const totalPagesElement = document.getElementById('totalPages');
    const currentPageElement = document.getElementById('currentPage');

    if (!flipbookElement || !window.St) {
      console.log('Flipbook element or StPageFlip library not found');
      return;
    }

    let pageFlip = null;
    let currentPage = 1;
    const totalPages = {{ section.blocks.size }};
    let autoplayInterval = null;
    let isAutoPlaying = false;
    let isZoomed = false;

    // Initialize StPageFlip
    function initFlipbook() {
      try {
        pageFlip = new St.PageFlip(flipbookElement, {
          width: {{ section.settings.page_width | default: 550 }},
          height: {{ section.settings.page_height | default: 733 }},
          size: "stretch",
          minWidth: 350,
          maxWidth: 700,
          minHeight: 467,
          maxHeight: 933,
          drawShadow: {{ section.settings.show_shadow | default: true }},
          flippingTime: {{ section.settings.flip_speed | default: 1000 }},
          usePortrait: {{ section.settings.use_portrait | default: true }},
          startZIndex: 0,
          autoSize: true,
          maxShadowOpacity: 0.5,
          showCover: true,
          mobileScrollSupport: false,
          swipeDistance: 30,
          clickEventForward: true,
          useMouseEvents: true
        });

        // Load pages from images
        const images = [];
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            images.push('{{ block.settings.image | image_url: width: 1600 }}');
          {% endif %}
        {% endfor %}

        if (images.length > 0) {
          pageFlip.loadFromImages(images);

          // Event listeners
          pageFlip.on('flip', (e) => {
            currentPage = parseInt(e.data) + 1;
            updatePageDisplay();
          });

          pageFlip.on('changeOrientation', (e) => {
            console.log('Orientation changed to:', e.data);
          });

          pageFlip.on('changeState', (e) => {
            console.log('State changed to:', e.data);
          });
        }
      } catch (error) {
        console.error('Error initializing flipbook:', error);
      }
    }

    // Update page display
    function updatePageDisplay() {
      if (currentPageElement) {
        currentPageElement.textContent = currentPage;
      }

      // Update page end display for theme-style format
      const currentPageEndElement = document.getElementById('currentPageEnd');
      if (currentPageEndElement) {
        // Show current page + 1 if not the last page (for spread view)
        const endPage = currentPage < totalPages ? currentPage + 1 : currentPage;
        currentPageEndElement.textContent = endPage;
      }

      // Update side navigation button states
      const prevBtn = document.getElementById('prevPage');
      const nextBtn = document.getElementById('nextPage');

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

      // Update page navigation button states
      const firstBtn = document.getElementById('firstPage');
      const prevSingleBtn = document.getElementById('prevSinglePage');
      const nextSingleBtn = document.getElementById('nextSinglePage');
      const lastBtn = document.getElementById('lastPage');

      if (firstBtn) firstBtn.disabled = currentPage <= 1;
      if (prevSingleBtn) prevSingleBtn.disabled = currentPage <= 1;
      if (nextSingleBtn) nextSingleBtn.disabled = currentPage >= totalPages;
      if (lastBtn) lastBtn.disabled = currentPage >= totalPages;
    }

    // Autoplay functions
    function startAutoplay() {
      if (autoplayInterval) return;

      isAutoPlaying = true;
      updateAutoplayButton();

      autoplayInterval = setInterval(() => {
        if (currentPage >= totalPages) {
          // Reset to first page when reaching the end
          if (pageFlip) {
            pageFlip.turnToPage(0);
            currentPage = 1;
            updatePageDisplay();
          }
        } else {
          // Go to next page
          if (pageFlip) {
            pageFlip.flipNext();
          }
        }
      }, 3000); // Change page every 3 seconds
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
      isAutoPlaying = false;
      updateAutoplayButton();
    }

    function toggleAutoplay() {
      if (isAutoPlaying) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    }

    function updateAutoplayButton() {
      const autoplayBtn = document.getElementById('autoplayBtn');
      const playIcon = autoplayBtn?.querySelector('.play-icon');
      const pauseIcon = autoplayBtn?.querySelector('.pause-icon');

      if (autoplayBtn && playIcon && pauseIcon) {
        if (isAutoPlaying) {
          playIcon.style.display = 'none';
          pauseIcon.style.display = 'block';
          autoplayBtn.classList.add('playing');
          autoplayBtn.title = 'Pause Auto Play';
        } else {
          playIcon.style.display = 'block';
          pauseIcon.style.display = 'none';
          autoplayBtn.classList.remove('playing');
          autoplayBtn.title = 'Auto Play';
        }
      }
    }

    // Fullscreen functions
    function toggleFullscreen() {
      const wrapper = document.getElementById('flipbookWrapper');
      if (!wrapper) return;

      if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.msFullscreenElement) {
        // Enter fullscreen
        if (wrapper.requestFullscreen) {
          wrapper.requestFullscreen();
        } else if (wrapper.webkitRequestFullscreen) {
          wrapper.webkitRequestFullscreen();
        } else if (wrapper.msRequestFullscreen) {
          wrapper.msRequestFullscreen();
        }
      } else {
        // Exit fullscreen
        if (document.exitFullscreen) {
          document.exitFullscreen();
        } else if (document.webkitExitFullscreen) {
          document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) {
          document.msExitFullscreen();
        }
      }
    }

    function updateFullscreenButton() {
      const fullscreenBtn = document.getElementById('fullscreenBtn');
      const enterIcon = fullscreenBtn?.querySelector('.fullscreen-enter-icon');
      const exitIcon = fullscreenBtn?.querySelector('.fullscreen-exit-icon');

      const isFullscreen = !!(document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement);

      if (fullscreenBtn && enterIcon && exitIcon) {
        if (isFullscreen) {
          enterIcon.style.display = 'none';
          exitIcon.style.display = 'block';
          fullscreenBtn.title = 'Exit Fullscreen';
        } else {
          enterIcon.style.display = 'block';
          exitIcon.style.display = 'none';
          fullscreenBtn.title = 'Enter Fullscreen';
        }
      }
    }

    // Zoom functions
    function toggleZoom() {
      const zoomBtn = document.getElementById('zoomToggle');
      const zoomInIcon = zoomBtn?.querySelector('.zoom-in-icon');
      const zoomOutIcon = zoomBtn?.querySelector('.zoom-out-icon');

      isZoomed = !isZoomed;

      if (zoomBtn && zoomInIcon && zoomOutIcon) {
        if (isZoomed) {
          zoomInIcon.style.display = 'none';
          zoomOutIcon.style.display = 'block';
          zoomBtn.classList.add('zoomed');
          zoomBtn.title = 'Zoom Out';
          // Apply zoom effect
          if (pageFlip) {
            const wrapper = document.querySelector('.stf__wrapper');
            if (wrapper) {
              wrapper.style.transform = 'scale(1.2)';
              wrapper.style.transition = 'transform 0.3s ease';
            }
          }
        } else {
          zoomInIcon.style.display = 'block';
          zoomOutIcon.style.display = 'none';
          zoomBtn.classList.remove('zoomed');
          zoomBtn.title = 'Zoom In';
          // Remove zoom effect
          if (pageFlip) {
            const wrapper = document.querySelector('.stf__wrapper');
            if (wrapper) {
              wrapper.style.transform = 'scale(1)';
            }
          }
        }
      }
    }

    // Event listeners
    document.addEventListener('click', function(e) {
      // Autoplay button
      if (e.target.closest('#autoplayBtn')) {
        e.preventDefault();
        toggleAutoplay();
      }

      // Fullscreen button
      if (e.target.closest('#fullscreenBtn')) {
        e.preventDefault();
        toggleFullscreen();
      }

      // Zoom button
      if (e.target.closest('#zoomToggle')) {
        e.preventDefault();
        toggleZoom();
      }

      // Navigation buttons
      if (e.target.closest('#prevPage')) {
        e.preventDefault();
        if (pageFlip) pageFlip.flipPrev();
      }

      if (e.target.closest('#nextPage')) {
        e.preventDefault();
        if (pageFlip) pageFlip.flipNext();
      }

      if (e.target.closest('#firstPage')) {
        e.preventDefault();
        if (pageFlip) {
          pageFlip.turnToPage(0);
          currentPage = 1;
          updatePageDisplay();
        }
      }

      if (e.target.closest('#lastPage')) {
        e.preventDefault();
        if (pageFlip) {
          pageFlip.turnToPage(totalPages - 1);
          currentPage = totalPages;
          updatePageDisplay();
        }
      }

      if (e.target.closest('#prevSinglePage')) {
        e.preventDefault();
        if (pageFlip) pageFlip.flipPrev();
      }

      if (e.target.closest('#nextSinglePage')) {
        e.preventDefault();
        if (pageFlip) pageFlip.flipNext();
      }

      if (e.target.closest('#previewView')) {
        e.preventDefault();
        openPreviewModal();
      }
    });

    // Fullscreen change events
    document.addEventListener('fullscreenchange', updateFullscreenButton);
    document.addEventListener('webkitfullscreenchange', updateFullscreenButton);
    document.addEventListener('msfullscreenchange', updateFullscreenButton);

    // Initialize flipbook when library is loaded
    if (window.St) {
      initFlipbook();
    } else {
      // Wait for library to load
      const checkLibrary = setInterval(() => {
        if (window.St) {
          clearInterval(checkLibrary);
          initFlipbook();
        }
      }, 100);
    }

    // Initialize button states
    updatePageDisplay();
    updateAutoplayButton();
    updateFullscreenButton();

    // Make functions globally accessible
    window.openImageModal = function(imageSrc) {
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage');

      if (modal && modalImage) {
        modalImage.src = imageSrc;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeImageModal = function() {
      const modal = document.getElementById('imageModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    };

    window.openPreviewModal = function() {
      const modal = document.getElementById('previewModal');
      if (modal) {
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        modal.focus();
      }
    };

    window.closePreviewModal = function() {
      const modal = document.getElementById('previewModal');
      if (modal) {
        modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    };

    window.goToPageFromPreview = function(pageNumber) {
      closePreviewModal();
      if (pageFlip && pageNumber >= 1 && pageNumber <= totalPages) {
        pageFlip.turnToPage(pageNumber - 1);
        currentPage = pageNumber;
        updatePageDisplay();

        const flipbookWrapper = document.querySelector('.flipbook-wrapper');
        if (flipbookWrapper) {
          flipbookWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    };

    // Close modal when clicking outside
    document.getElementById('imageModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closeImageModal();
      }
    });

    // Close preview modal when clicking outside
    document.getElementById('previewModal')?.addEventListener('click', function(e) {
      if (e.target === this) {
        closePreviewModal();
      }
    });

    // Close modals with Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const imageModal = document.getElementById('imageModal');
        const previewModal = document.getElementById('previewModal');

        if (previewModal && previewModal.classList.contains('active')) {
          closePreviewModal();
        } else if (imageModal && imageModal.classList.contains('active')) {
          closeImageModal();
        }
      }
    });
  });
</script>
{% schema %}
{
  "name": "Image Flipbook Catalog",
  "settings": [
    { "type": "header", "content": "Content Settings" },
    { "type": "checkbox", "id": "show_header", "label": "Show Header", "default": true },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "LAWN '25 NEW ARRIVALS",
      "info": "Main title for the flipbook section"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Browse our latest collection",
      "info": "Optional subtitle text"
    },

    { "type": "header", "content": "Flipbook Settings" },
    {
      "type": "number",
      "id": "page_width",
      "label": "Page Width (px)",
      "default": 550,
      "info": "Width of each page in the flipbook"
    },
    {
      "type": "number",
      "id": "page_height",
      "label": "Page Height (px)",
      "default": 733,
      "info": "Height of each page in the flipbook"
    },
    {
      "type": "range",
      "id": "flip_speed",
      "label": "Flip Animation Speed (ms)",
      "min": 500,
      "max": 2000,
      "step": 100,
      "default": 1000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show Page Shadows",
      "default": true,
      "info": "Display realistic shadows during page flips"
    },

    /* Note: use integer range for opacity (percentage) */

    {
      "type": "checkbox",
      "id": "use_portrait",
      "label": "Enable Portrait Mode",
      "default": true,
      "info": "Allow single page view on mobile devices"
    },
    {
      "type": "checkbox",
      "id": "single_first_last",
      "label": "Single First & Last Pages",
      "default": true,
      "info": "Show first and last pages as single pages (like book covers)"
    },

    { "type": "header", "content": "Layout Settings" },
    {
      "type": "number",
      "id": "max_width",
      "label": "Maximum Width (px)",
      "default": 1200,
      "info": "Maximum width of the flipbook container"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },

    { "type": "header", "content": "Typography" },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Title Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Section Background", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Title Color", "default": "#000000" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle Color", "default": "#666666" },
    { "type": "color", "id": "button_bg_color", "label": "Button Background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Color", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_color", "label": "Button Hover Color", "default": "#333333" },

    { "type": "header", "content": "Controls" },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show Navigation Controls",
      "default": true,
      "info": "Display navigation buttons and page counter"
    },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "page",
      "name": "Catalog Page",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Page Image",
          "info": "Upload an image for this catalog page"
        },
        { "type": "text", "id": "alt_text", "label": "Alt Text", "info": "Describe the image for accessibility" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Flipbook Catalog",
      "category": "Custom Sections",
      "blocks": [{ "type": "page" }, { "type": "page" }, { "type": "page" }, { "type": "page" }]
    }
  ]
}
{% endschema %}
