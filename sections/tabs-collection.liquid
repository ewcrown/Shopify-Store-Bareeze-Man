
<section class="collection-tabs-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% comment %} <div class="collection-tabs-heading">
    <h2>
      {% if collection %}
        {{ collection.title }}
      {% endif %}
    </h2>
  </div> {% endcomment %}

<div class="collection-tabs-container">
  {% for block in section.blocks %}
    {% assign col = block.settings.heading %}
    {% assign url_col = block.settings.url_col %}

    {% if col != blank and url_col != blank %}
      <a href="{{ url_col }}"
         class="collection-tab {% if url_col contains request.path %}active{% endif %}">
        {{ col }}
      </a>
    {% endif %}
  {% endfor %}
</div>
</section>

<style>
.collection-tabs-heading h2 {
    font-size: 30px;
    font-weight: 500;
    margin-bottom: 15px;
    font-family: Montserrat, sans-serif;
    line-height: 1;
    text-transform: uppercase;
}

.collection-tabs-section {
    padding-left: 30px;
    margin-bottom: 30px;
}

.collection-tabs-container {
  display: flex;
  gap: 0; 
  padding: 10px 0;
  overflow-x: auto;
}

.collection-tab {
  text-decoration: none;
  font-size: 14px;
  font-weight: normal; 
  color: #000;
  padding-left: 20px;
  padding-right: 10px; 
  white-space: nowrap;
  position: relative;
  font-family: Montserrat, sans-serif;
  border-right: 1px solid #282828;
  height: 13.5px;
  text-transform: uppercase;
}

.collection-tab:first-child {
  padding-left: 0;
}

.collection-tab:last-child {
  border-right: none;
}

.collection-tab.active {
  font-weight: 600;  
  color: #000;
}

.collection-tab.active::after {
  content: none;
}

.collection-tabs-container::-webkit-scrollbar {
  display: none;
}
.collection-tabs-container {
  scrollbar-width: none;
}

@media (max-width: 768px) {
  .collection-tab {
    font-size: 13px;
    padding-right: 10px;
  }
}
</style>

{% schema %}
{
  "name": "Dynamic Collection",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
{
    "type": "text",
    "id": "heading",
    "label": "heading"
    },
    {
    "type": "url",
    "id": "url_col",
    "label": "url"
    }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Collection Tabs"
    }
  ]
}
{% endschema %}
