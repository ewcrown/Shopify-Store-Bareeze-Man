<!-- sections/store-locator-homepage.liquid -->
{{ 'store-locator-homepage.css' | asset_url | stylesheet_tag }}

<section class="m-homepage-stores m-section">
  <div class="container">
    <!-- Section Header -->
    {% if section.settings.heading != blank %}
      <div class="m-section__header">
        <h2 class="m-section__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="m-section__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Store Cards Grid -->
    <div class="m-stores-grid" style="--columns: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};">
      {% for block in section.blocks %}
        <div class="m-store-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="m-store-card__image">
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}
          
          <div class="m-store-card__content">
            <h3 class="m-store-card__name">{{ block.settings.store_name }}</h3>
            
            {% if block.settings.address != blank %}
              <div class="m-store-card__address">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>{{ block.settings.address }}</span>
              </div>
            {% endif %}
            
            {% if block.settings.phone != blank %}
              <div class="m-store-card__phone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
                <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
              </div>
            {% endif %}
            
            {% if block.settings.hours != blank %}
              <div class="m-store-card__hours">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"/>
                </svg>
                <span>{{ block.settings.hours }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- View All Button -->
    {% if section.settings.show_view_all %}
      <div class="m-stores__cta">
        <a href="{{ section.settings.store_page_url | default: '/pages/find-a-store' }}" 
           class="m-button m-button--primary">
          {{ section.settings.cta_text | default: 'View All Stores' }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Store Locator - Homepage",
  "tag": "section",
  "class": "m-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Our Stores"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Visit us at any of our locations"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "View All Stores"
    },
    {
      "type": "url",
      "id": "store_page_url",
      "label": "Store Page URL"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store Location",
      "settings": [
        {
          "type": "text",
          "id": "store_name",
          "label": "Store Name",
          "default": "Store Name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Store Image"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "123 Main Street, City, State 12345"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number",
          "default": "+1 (555) 123-4567"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Store Hours",
          "default": "Mon-Sat: 9AM-8PM"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator - Homepage",
      "blocks": [
        {
          "type": "store",
          "settings": {
            "store_name": "Main Store",
            "address": "123 Main Street, Karachi",
            "phone": "+92 21 1234567",
            "hours": "Mon-Sat: 10AM-10PM"
          }
        },
        {
          "type": "store",
          "settings": {
            "store_name": "Mall Branch",
            "address": "456 Mall Road, Lahore",
            "phone": "+92 42 1234567",
            "hours": "Daily: 11AM-11PM"
          }
        }
      ]
    }
  ]
}
{% endschema %}
