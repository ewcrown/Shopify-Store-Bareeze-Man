{"sections":{"main":{"type":"page-contact","disabled":true,"settings":{"container":"container-fluid"}},"contact-form":{"type":"contact-form","blocks":{"textblock_t9GiJL":{"type":"textblock","disabled":true,"settings":{"title":"","content":"","custom_code":"<div class=\"tabs__buttons--container\">\n  <button class=\"tabs__tab-btn\" data-tab-id=\"dubai\">Dubai<\/button>\n  <button class=\"tabs__tab-btn\" data-tab-id=\"sharjah\">Sharjah<\/button>\n  <button class=\"tabs__tab-btn\" data-tab-id=\"abudhabi\">Abu Dhabi<\/button>\n  <button class=\"tabs__tab-btn\" data-tab-id=\"london\">London<\/button>\n<\/div>\n\n<div data-tab=\"dubai\" class=\"tabs__tab\">\n  <strong>Meena Bazar<\/strong><br>\n  Shop#1, Meena Bazaar, Bldg. Bait Al Waleed, <br>Khalid Bin Waleed Rd, Bur Dubai, UAE <br>\n  <strong>Phone:<\/strong> +971 (04) 327 6190<br><\/br>\n  <strong>Outlet Mall<\/strong><br>\n  First Floor, Shop F25A, Madinat Hind 1,<br> Dubai Outlet Mall, Dubai, UAE<br>\n  <strong>Phone<\/strong> +971 (04) 256 2128\n<\/div>\n\n<div data-tab=\"sharjah\" class=\"tabs__tab\">\n  <strong>Rolla<\/strong><br>\n  Shop# 4,5,6, Rolla, Al Shazef Building,<br> Al Arouba St, Al Mareija, Sharjah, UAE<br>\n  <strong>Phone:<\/strong> +971 (06) 568 9647\n<\/div>\n\n<div data-tab=\"abudhabi\" class=\"tabs__tab\">\n  <strong>Khaldiyah<\/strong><br>\n  Shop 2, Khaldia Tower, Zayed The First St., <br>Al Hisn, Abu Dhabi, UAE<br>\n  <strong>Phone:<\/strong> +971 (02) 621 0174\n<\/div>\n\n<div data-tab=\"london\" class=\"tabs__tab\">\n  <strong> Green St.<\/strong><br>\n  102 Green St, London E7 8JG, <br>United Kingdom<br>\n  <strong>Phone:<\/strong> +44 (20) 8821 9991\n<\/div>\n\n<style>\n.tabs__buttons--container {\n  display: flex;\n  margin-bottom: 1rem;\n}\n\n.tabs__tab-btn {\n  background: #f8f8f8;\n  border: none;\n  padding: 0.4rem 1rem;\n  cursor: pointer;\n  border-bottom: solid 3px #000;\n  flex: 1 0;\n}\n\n.tabs__tab-btn--not-selected {\n  border-bottom-color: #aaa;\n  background: transparent;\n}\n\n.tabs__tab-btn:hover {\n  transition: 0.3s;\n}\n\n.tabs__tab--hide {\n  display: none;\n}\n\n.tabs__tab--show {\n  display: block;\n}\n\n.tabs__tab {\n  animation: tabApear 0.6s;\n}\n\n@keyframes tabApear {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n<\/style>\n<script>\nconst tabsBtns = Array.from(document.querySelectorAll(\"[data-tab-id]\"));\nconst tabs = Array.from(document.querySelectorAll(\"[data-tab]\"));\n\nlet selectedTab = tabsBtns[0].dataset.tabId;\n\nconst hideTabs = () => {\n  tabs\n    .filter((tab) => tab.dataset.tab !== selectedTab)\n    .forEach((tab) => {\n      tab.classList.add(\"tabs__tab--hide\");\n    });\n\n  tabsBtns\n    .filter((tab) => tab.dataset.tabId !== selectedTab)\n    .forEach((tab) => {\n      tab.classList.add(\"tabs__tab-btn--not-selected\");\n    });\n};\nhideTabs();\n\nconst handleSelectTab = (e) => {\n  selectedTab = e.target.dataset.tabId;\n\n  tabs.forEach((tab) => {\n    tab.classList.remove(\"tabs__tab--hide\");\n  });\n\n  tabsBtns.forEach((tab) => {\n    tab.classList.remove(\"tabs__tab-btn--not-selected\");\n  });\n\n  hideTabs();\n};\n\ntabsBtns.forEach((btn) => {\n  btn.addEventListener(\"click\", handleSelectTab);\n});\n<\/script>"}},"text-block-2":{"type":"textblock","settings":{"title":"Information","content":"<p>+92-213 889 3968<br\/>+92 300 056 9696<br\/>customercare@bareezeman.com<\/p>","custom_code":""}},"text-block-3":{"type":"socialmedia","settings":{"title":"Social Media"}},"text-block-4":{"type":"textblock","settings":{"title":"We're Open","content":"<p>Our stores are open for shopping and exchanges<\/p><p>Every day at 11am to 11pm<\/p>","custom_code":""}}},"block_order":["textblock_t9GiJL","text-block-2","text-block-3","text-block-4"],"custom_css":["h2,h4,p {margin: 0;}"],"settings":{"container":"container-fluid","title":"","description":"<h3>Please enter your details below or contact us<\/h3><h4><strong>We would love to hear from you.<\/strong><\/h4><p>Questions? We’re happy to help. Give us a call or send a message below and one of our experts will get back to you.<\/p>","show_name":true,"show_phone":false,"show_signup_email":false,"animations":"inherit"}},"custom_liquid_caWxXG":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n#MainContent{\n   padding-bottom: 0 !important;\n}\n<\/style>","custom_class":""}}},"order":["main","contact-form","custom_liquid_caWxXG"]}