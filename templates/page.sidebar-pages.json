{"sections":{"main":{"type":"page","disabled":true,"settings":{}},"custom_liquid_bFHGbk":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\npages-content h1, .pages-content h2, .pages-content h3, .pages-content h4, .pages-content h5, .pages-content h6{\n   font-weight: bold;\n}\n  .sidebar-navs {\n    background-color: #f1f1f1;\n    padding-bottom: 50px;\n}\n  .sidebar-navs, .pages-content {\n    padding-top: 50px;\n    padding-left: 15px;\n      padding-right: 15px;\n}\n  .pages-content {\n      padding-bottom: 50px;\n  }\n    .pages-content h2 {\n      margin-bottom: 10px;\n    }\n  .pages-content h1 {\n      margin-bottom: 20px;\n    }\n  .pages-content ul {\n    list-style-type: disc;\n    margin-left: 17px;\n}\n  .pages-content p {\n      margin-bottom: 25px;\n  }\n    .sidebar-title{\n      text-transform: uppercase;\n      font-size: 20px;\n      margin-bottom: 30px;\n      font-weight: bold;\n    }\n    .sidebar-navs-wrap {\n      position: sticky;\n      top: 50px;\n    }\n    .sidebar-navs-wrap h3{\n        margin-top: 0;\n      }\n    @media (max-width: 1023px){\n      .sidebar-pages-template .sidebar-navs{\n        display: none;\n      }\n       .pages-content {\n         padding-top: 30px;\n       }\n    }\n    .sidebar-navigation-list a {\n      color: #666666;\n      font-size: 14px;\n      display: block;\n      padding: 20px 0;\n      border-top: 1px solid #ddd;\n    }\n  .sidebar-navigation-list a:last-child {\n    border-bottom: 1px solid #ddd;\n  }\n    .sidebar-navigation-list a:hover, .sidebar-navigation-list a:active {\n      color: #000000;\n    }\n    .sidebar-navigation-list li.site-nav--active a{\n      color: #000000;\n    }\n    .pages-content a {\n      text-decoration: underline;\n    }\n  .pages-content h2 {\n    font-family: var(--font-stack-body)!important;\n    font-size: 20px;\n}\n  .pages-content ul, .pages-content ol {\n    margin: 0 0 20px 17px;\n}\n  .pages-content ol {\n    list-style-type: number;\n}\n  .pages-content ul {\n    list-style-type: disc;\n}\n  .pages-content > p:last-child {\n    margin-bottom: 0;\n}\n #MainContent{\n      padding-bottom: 0 !important;\n    }\n  @media (min-width: 1280px){\n\t.sidebar-navs {\n\t    padding-left: var(--fluid-container-offset,6rem);\n\t}\n    .pages-content {\n\t    padding-right: var(--fluid-container-offset,6rem);\n\t}    \n}\n\n<\/style>\n<div class=\"page-wrap\">\n  <div class=\"container-custom\">\n    <div class=\"sidebar-pages-template\">\n      <div class=\"flex flex-wrap\">\n        <div class=\"lg:m:w-3\/12 sidebar-navs\">\n            <div class=\"sidebar-navs-wrap\">\n            <h3 class=\"sidebar-title\">Quick Links<\/h3>\n            <div class=\"sidebar-navigation-list\">\n              <ul class=\"list-unstyled\">\n                {%- for link in linklists['sidebar-menu'].links -%}\n                  <li\n                    {% if link.active %}\n                      class=\"site-nav--active\"\n                    {% endif %}\n                  >\n                    <a\n                      {% if link.url == blank %}\n                        role=\"link\" aria-disabled=\"true\"\n                      {% else %}\n                        href=\"{{ link.url }}\"\n                      {% endif %}\n                      class=\"link link-underline list-menu__item--link {% if link.active %} site-nav__link--active{% endif %}\"\n                      {% if link.current %}\n                        aria-current=\"page\"\n                      {% endif %}\n                    >\n                      <span class=\"text\">{{ link.title }}<\/span>\n                    <\/a>\n                  <\/li>\n                {%- endfor -%}\n              <\/ul>\n            <\/div>\n          <\/div>\n        <\/div>\n        <div class=\"lg:m:w-9\/12 pages-content\">\n          {{ page.content }}\n        <\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>","custom_class":""}}},"order":["main","custom_liquid_bFHGbk"]}